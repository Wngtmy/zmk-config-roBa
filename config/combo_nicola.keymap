        COMBO_NICOLA(ni, &n_ni, 6 41, 100) //に
        COMBO_NICOLA(ru, &n_ru, 7 41, 100) //る
        COMBO_NICOLA(ma, &n_ma, 8 41, 100) //ま
        COMBO_NICOLA(le, &n_le, 9 41, 100) //ぇ
        COMBO_NICOLA(vu, &n_vu, 10 41, 100) //ヴ
